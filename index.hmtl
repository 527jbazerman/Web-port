<script>
// CURSOR
const cursor = document.getElementById('cursor');
const trail = document.getElementById('cursorTrail');
let mx=0,my=0,tx=0,ty=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cursor.style.left=mx+'px';cursor.style.top=my+'px'});
function animateTrail(){tx+=(mx-tx)*0.12;ty+=(my-ty)*0.12;trail.style.left=tx+'px';trail.style.top=ty+'px';requestAnimationFrame(animateTrail)}
animateTrail();

// NAV SCROLL
const nav=document.getElementById('navbar');
const prog=document.getElementById('scrollProgress');
window.addEventListener('scroll',()=>{
  nav.classList.toggle('scrolled',window.scrollY>60);
  const pct=window.scrollY/(document.body.scrollHeight-window.innerHeight)*100;
  prog.style.width=pct+'%';
});

// COUNTER ANIMATION
function animateCounter(el,target,duration=2000,suffix=''){
  const start=performance.now();
  const update=now=>{
    const p=Math.min((now-start)/duration,1);
    const ease=1-Math.pow(1-p,3);
    el.textContent=Math.floor(ease*target).toLocaleString()+(suffix?suffix:'');
    if(p<1)requestAnimationFrame(update);
  };
  requestAnimationFrame(update);
}
const counters=document.querySelectorAll('[data-target]');
const counterObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      const t=+e.target.dataset.target;
      animateCounter(e.target,t);
      counterObs.unobserve(e.target);
    }
  });
},{threshold:0.5});
counters.forEach(c=>counterObs.observe(c));

// SCROLL REVEAL
const reveals=document.querySelectorAll('.reveal,.reveal-left,.reveal-right');
const revObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');revObs.unobserve(e.target)}});
},{threshold:0.15});
reveals.forEach(r=>revObs.observe(r));

// PLAN BUTTON INTERACTION
document.querySelectorAll('.plan-btn').forEach(btn=>{
  btn.addEventListener('click',function(){
    this.textContent='✓ Selected!';
    setTimeout(()=>this.textContent='Get Started',2000);
  });
});
</script>
</body>
