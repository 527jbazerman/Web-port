<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IRONFORGE — Elite Training</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,600;1,300&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --red:#e63329;--red-dark:#b82820;--black:#080808;--dark:#111;
  --gray:#1a1a1a;--light:#f0ede8;--muted:#666;
}
html{scroll-behavior:smooth}
body{font-family:'Barlow',sans-serif;background:var(--black);color:var(--light);overflow-x:hidden}

/* CURSOR */
.cursor{position:fixed;width:12px;height:12px;background:var(--red);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform 0.1s;mix-blend-mode:difference}
.cursor-trail{position:fixed;width:40px;height:40px;border:1px solid var(--red);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:all 0.12s ease;opacity:0.4}
body{cursor:none}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:24px 64px;transition:all 0.4s}
nav.scrolled{background:rgba(8,8,8,0.96);padding:16px 64px;border-bottom:1px solid rgba(230,51,41,0.2)}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:0.12em;color:var(--light);text-decoration:none}
.nav-logo span{color:var(--red)}
.nav-links{display:flex;gap:36px;list-style:none}
.nav-links a{font-size:0.72rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:rgba(240,237,232,0.6);text-decoration:none;transition:color 0.3s}
.nav-links a:hover{color:var(--red)}
.nav-cta{background:var(--red);color:var(--light);padding:10px 28px;font-size:0.65rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;text-decoration:none;transition:background 0.3s;font-family:'Barlow',sans-serif}
.nav-cta:hover{background:var(--red-dark)}

/* HERO */
.hero{height:100vh;position:relative;display:flex;align-items:flex-end;overflow:hidden;padding:80px 64px}
.hero-video-bg{position:absolute;inset:0;background:
  url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1800&q=80') center/cover no-repeat;
  transform:scale(1.05);animation:zoomOut 8s ease forwards}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(135deg,rgba(8,8,8,0.92) 0%,rgba(8,8,8,0.3) 60%,rgba(230,51,41,0.1) 100%)}
.hero-content{position:relative;z-index:2;max-width:800px}
.hero-tag{font-size:0.65rem;font-weight:600;letter-spacing:0.4em;text-transform:uppercase;color:var(--red);margin-bottom:20px;opacity:0;animation:slideUp 0.8s 0.2s forwards}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(6rem,14vw,13rem);line-height:0.88;letter-spacing:0.02em;margin-bottom:28px;opacity:0;animation:slideUp 0.8s 0.4s forwards}
.hero-title .accent{color:var(--red);display:block}
.hero-sub{font-size:1rem;font-weight:300;color:rgba(240,237,232,0.6);max-width:420px;line-height:1.7;margin-bottom:48px;opacity:0;animation:slideUp 0.8s 0.6s forwards}
.hero-btns{display:flex;gap:16px;opacity:0;animation:slideUp 0.8s 0.8s forwards}
.btn-primary{background:var(--red);color:var(--light);padding:16px 44px;font-size:0.72rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;text-decoration:none;display:inline-block;transition:all 0.3s;position:relative;overflow:hidden}
.btn-primary::after{content:'';position:absolute;inset:0;background:rgba(255,255,255,0.1);transform:translateX(-100%);transition:transform 0.3s}
.btn-primary:hover::after{transform:translateX(0)}
.btn-secondary{border:1px solid rgba(240,237,232,0.3);color:var(--light);padding:16px 44px;font-size:0.72rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;text-decoration:none;display:inline-block;transition:all 0.3s}
.btn-secondary:hover{border-color:var(--red);color:var(--red)}
.hero-stats{position:absolute;right:64px;bottom:80px;z-index:2;display:flex;flex-direction:column;gap:28px;opacity:0;animation:slideUp 0.8s 1s forwards}
.stat{text-align:right}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:3rem;color:var(--red);line-height:1}
.stat-label{font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:rgba(240,237,232,0.4)}
.scroll-bar{position:absolute;bottom:0;left:0;right:0;height:3px;background:rgba(240,237,232,0.1)}
.scroll-progress{height:100%;background:var(--red);width:0%;transition:width 0.1s}

/* STATS STRIP */
.stats-strip{background:var(--red);padding:28px 64px;display:flex;justify-content:space-around;align-items:center}
.strip-stat{text-align:center}
.strip-num{font-family:'Bebas Neue',sans-serif;font-size:2.8rem;color:var(--light);line-height:1}
.strip-label{font-size:0.62rem;letter-spacing:0.22em;text-transform:uppercase;color:rgba(240,237,232,0.75)}
.strip-divider{width:1px;height:50px;background:rgba(240,237,232,0.25)}

/* ABOUT */
.about{padding:140px 64px;display:grid;grid-template-columns:1fr 1fr;gap:120px;align-items:center}
.about-visual{position:relative}
.about-img{width:100%;aspect-ratio:3/4;object-fit:cover;filter:grayscale(20%)}
.about-badge{position:absolute;bottom:-30px;right:-30px;width:140px;height:140px;background:var(--red);display:flex;flex-direction:column;align-items:center;justify-content:center}
.badge-num{font-family:'Bebas Neue',sans-serif;font-size:3.5rem;color:var(--light);line-height:1}
.badge-text{font-size:0.55rem;letter-spacing:0.2em;text-transform:uppercase;color:rgba(240,237,232,0.8);text-align:center}
.section-kicker{font-size:0.62rem;letter-spacing:0.4em;text-transform:uppercase;color:var(--red);margin-bottom:20px}
.section-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(3rem,6vw,5.5rem);line-height:0.92;margin-bottom:28px;letter-spacing:0.02em}
.section-body{font-size:0.88rem;line-height:1.9;color:rgba(240,237,232,0.6);margin-bottom:36px}
.feature-list{list-style:none;display:flex;flex-direction:column;gap:16px;margin-bottom:48px}
.feature-list li{display:flex;align-items:center;gap:14px;font-size:0.82rem;color:rgba(240,237,232,0.7)}
.feature-list li::before{content:'';width:24px;height:2px;background:var(--red);flex-shrink:0}

/* PROGRAMS */
.programs{padding:120px 64px;background:var(--dark)}
.programs-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:72px}
.programs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}
.program-card{position:relative;overflow:hidden;aspect-ratio:3/4;cursor:none}
.program-img{width:100%;height:100%;object-fit:cover;transition:transform 0.7s ease;filter:brightness(0.5) grayscale(30%)}
.program-card:hover .program-img{transform:scale(1.08);filter:brightness(0.7)}
.program-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(8,8,8,0.95) 0%,transparent 50%);display:flex;flex-direction:column;justify-content:flex-end;padding:36px 32px}
.program-tag{font-size:0.58rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.program-name{font-family:'Bebas Neue',sans-serif;font-size:2.4rem;line-height:1;margin-bottom:12px}
.program-desc{font-size:0.75rem;color:rgba(240,237,232,0.6);line-height:1.6;max-height:0;overflow:hidden;transition:max-height 0.5s ease,margin 0.5s}
.program-card:hover .program-desc{max-height:100px;margin-bottom:16px}
.program-link{font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--red);text-decoration:none;display:flex;align-items:center;gap:8px}
.program-link::after{content:'→';transition:transform 0.3s}
.program-card:hover .program-link::after{transform:translateX(6px)}

/* TRAINERS */
.trainers{padding:120px 64px}
.trainers-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:72px}
.trainer-card{position:relative;overflow:hidden;cursor:none}
.trainer-img{width:100%;aspect-ratio:2/3;object-fit:cover;filter:grayscale(60%);transition:filter 0.5s,transform 0.5s}
.trainer-card:hover .trainer-img{filter:grayscale(0%);transform:scale(1.04)}
.trainer-info{padding:20px 0 8px}
.trainer-name{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;letter-spacing:0.05em;margin-bottom:4px}
.trainer-role{font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--red)}
.trainer-bar{position:absolute;top:0;left:0;width:3px;height:100%;background:var(--red);transform:scaleY(0);transform-origin:top;transition:transform 0.5s}
.trainer-card:hover .trainer-bar{transform:scaleY(1)}

/* PRICING */
.pricing{padding:120px 64px;background:var(--gray)}
.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;margin-top:72px}
.plan{padding:52px 40px;background:var(--dark);position:relative;transition:background 0.4s}
.plan.featured{background:var(--red)}
.plan.featured .plan-price,.plan.featured .plan-currency,.plan.featured .plan-period{color:var(--light)}
.plan.featured .plan-feature{color:rgba(240,237,232,0.85)}
.plan.featured .plan-feature::before{background:var(--light)}
.plan-badge{position:absolute;top:24px;right:24px;background:var(--light);color:var(--red);font-size:0.55rem;letter-spacing:0.2em;text-transform:uppercase;padding:4px 12px;font-weight:600}
.plan-name{font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:rgba(240,237,232,0.5);margin-bottom:28px}
.plan.featured .plan-name{color:rgba(240,237,232,0.7)}
.plan-price-row{display:flex;align-items:flex-start;gap:4px;margin-bottom:8px}
.plan-currency{font-size:1.4rem;color:var(--red);margin-top:8px}
.plan-price{font-family:'Bebas Neue',sans-serif;font-size:5rem;color:var(--light);line-height:1}
.plan-period{font-size:0.72rem;color:rgba(240,237,232,0.4);align-self:flex-end;margin-bottom:10px}
.plan-divider{height:1px;background:rgba(240,237,232,0.08);margin:28px 0}
.plan.featured .plan-divider{background:rgba(240,237,232,0.2)}
.plan-features{list-style:none;display:flex;flex-direction:column;gap:14px;margin-bottom:40px}
.plan-feature{font-size:0.78rem;color:rgba(240,237,232,0.6);display:flex;align-items:center;gap:12px}
.plan-feature::before{content:'';width:18px;height:1px;background:var(--red);flex-shrink:0}
.plan-btn{width:100%;padding:16px;background:transparent;border:1px solid rgba(240,237,232,0.2);color:var(--light);font-family:'Barlow',sans-serif;font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;cursor:none;transition:all 0.3s;font-weight:600}
.plan.featured .plan-btn{background:var(--light);color:var(--red);border-color:var(--light)}
.plan-btn:hover{background:var(--light);color:var(--dark);border-color:var(--light)}
.plan.featured .plan-btn:hover{background:var(--dark);color:var(--light);border-color:var(--dark)}

/* TESTIMONIALS */
.testimonials{padding:120px 64px;overflow:hidden}
.testimonials-track{display:flex;gap:28px;animation:scroll 30s linear infinite}
.testimonials-track:hover{animation-play-state:paused}
.testimonial{flex-shrink:0;width:380px;background:var(--gray);padding:40px;position:relative}
.testimonial::before{content:'"';font-family:'Bebas Neue',sans-serif;font-size:6rem;color:var(--red);line-height:1;opacity:0.3;position:absolute;top:16px;right:24px}
.testimonial-text{font-size:0.85rem;line-height:1.9;color:rgba(240,237,232,0.7);margin-bottom:28px;font-style:italic}
.testimonial-author{display:flex;align-items:center;gap:14px}
.author-avatar{width:44px;height:44px;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:1.2rem}
.author-name{font-weight:600;font-size:0.82rem;margin-bottom:2px}
.author-role{font-size:0.62rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--red)}
.stars{color:var(--red);font-size:0.8rem;margin-bottom:16px;letter-spacing:2px}

/* CTA BANNER */
.cta-banner{padding:120px 64px;background:var(--red);text-align:center;position:relative;overflow:hidden}
.cta-banner::before{content:'FORGE YOUR BODY';position:absolute;font-family:'Bebas Neue',sans-serif;font-size:20vw;color:rgba(0,0,0,0.08);white-space:nowrap;top:50%;left:50%;transform:translate(-50%,-50%);letter-spacing:0.05em}
.cta-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(3rem,8vw,7rem);line-height:0.9;margin-bottom:24px;position:relative}
.cta-sub{font-size:1rem;color:rgba(240,237,232,0.8);margin-bottom:48px;position:relative}
.cta-btns{display:flex;gap:16px;justify-content:center;position:relative}
.btn-white{background:var(--light);color:var(--red);padding:18px 52px;font-size:0.72rem;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;text-decoration:none;display:inline-block;transition:all 0.3s}
.btn-white:hover{background:var(--dark);color:var(--light)}
.btn-outline-white{border:2px solid var(--light);color:var(--light);padding:18px 52px;font-size:0.72rem;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;text-decoration:none;display:inline-block;transition:all 0.3s}
.btn-outline-white:hover{background:var(--light);color:var(--red)}

/* FOOTER */
footer{background:var(--black);padding:80px 64px 36px;border-top:1px solid rgba(230,51,41,0.15)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px}
.footer-brand .nav-logo{display:block;font-size:2.4rem;margin-bottom:18px}
.footer-brand p{font-size:0.78rem;line-height:1.9;color:rgba(240,237,232,0.4);max-width:260px}
.footer-col h4{font-size:0.6rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--red);margin-bottom:22px}
.footer-col ul{list-style:none}
.footer-col li{font-size:0.75rem;color:rgba(240,237,232,0.45);margin-bottom:12px;cursor:none;transition:color 0.3s}
.footer-col li:hover{color:var(--light)}
.footer-bottom{border-top:1px solid rgba(240,237,232,0.06);padding-top:28px;display:flex;justify-content:space-between}
.footer-bottom p{font-size:0.65rem;color:rgba(240,237,232,0.25);letter-spacing:0.1em}

/* ANIMATIONS */
@keyframes zoomOut{from{transform:scale(1.1)}to{transform:scale(1)}}
@keyframes slideUp{to{opacity:1;transform:translateY(0)}}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.reveal{opacity:0;transform:translateY(50px);transition:opacity 0.8s ease,transform 0.8s ease}
.reveal.visible{opacity:1;transform:none}
.reveal-left{opacity:0;transform:translateX(-60px);transition:opacity 0.8s ease,transform 0.8s ease}
.reveal-left.visible{opacity:1;transform:none}
.reveal-right{opacity:0;transform:translateX(60px);transition:opacity 0.8s ease,transform 0.8s ease}
.reveal-right.visible{opacity:1;transform:none}
[style*="animation"]{transform:translateY(30px)}
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-trail" id="cursorTrail"></div>

<nav id="navbar">
  <a href="#" class="nav-logo">IRON<span>FORGE</span></a>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#programs">Programs</a></li>
    <li><a href="#trainers">Trainers</a></li>
    <li><a href="#pricing">Pricing</a></li>
  </ul>
  <a href="#pricing" class="nav-cta">Join Now</a>
</nav>

<!-- HERO -->
<section class="hero" id="home">
  <div class="hero-video-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-tag">Elite Performance Training</p>
    <h1 class="hero-title">
      FORGE<br>
      <span class="accent">YOUR</span>
      LEGEND
    </h1>
    <p class="hero-sub">Where iron meets will. Train with the best, become unstoppable. No excuses. No limits. Only results.</p>
    <div class="hero-btns">
      <a href="#programs" class="btn-primary">Explore Programs</a>
      <a href="#about" class="btn-secondary">Learn More</a>
    </div>
  </div>
  <div class="hero-stats">
    <div class="stat"><div class="stat-num" data-target="12">0</div><div class="stat-label">Locations</div></div>
    <div class="stat"><div class="stat-num" data-target="340">0</div><div class="stat-label">Expert Trainers</div></div>
    <div class="stat"><div class="stat-num" data-target="50000">0</div><div class="stat-label">Members</div></div>
  </div>
  <div class="scroll-bar"><div class="scroll-progress" id="scrollProgress"></div></div>
</section>

<!-- STATS STRIP -->
<div class="stats-strip">
  <div class="strip-stat"><div class="strip-num" data-target="15">0</div><div class="strip-label">Years of Excellence</div></div>
  <div class="strip-divider"></div>
  <div class="strip-stat"><div class="strip-num" data-target="98">0</div><div class="strip-label">% Member Satisfaction</div></div>
  <div class="strip-divider"></div>
  <div class="strip-stat"><div class="strip-num" data-target="200">0</div><div class="strip-label">Classes Per Week</div></div>
  <div class="strip-divider"></div>
  <div class="strip-stat"><div class="strip-num" data-target="47">0</div><div class="strip-label">Certified Coaches</div></div>
</div>

<!-- ABOUT -->
<section class="about" id="about">
  <div class="about-visual reveal-left">
    <img class="about-img" src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&q=80" alt="Training">
    <div class="about-badge">
      <div class="badge-num">15</div>
      <div class="badge-text">Years<br>Strong</div>
    </div>
  </div>
  <div class="about-content reveal-right">
    <p class="section-kicker">Who We Are</p>
    <h2 class="section-title">NOT JUST A GYM.<br>A LIFESTYLE.</h2>
    <p class="section-body">IRONFORGE was built for those who refuse to settle. We combine elite coaching methodology with cutting-edge equipment and a community that pushes you past every limit you thought you had.</p>
    <ul class="feature-list">
      <li>State-of-the-art equipment across 40,000 sq ft</li>
      <li>Personalized nutrition and recovery programs</li>
      <li>24/7 access with biometric entry system</li>
      <li>Monthly fitness assessments and goal tracking</li>
      <li>On-site physiotherapy and sports medicine</li>
    </ul>
    <a href="#programs" class="btn-primary" style="display:inline-block">View Programs</a>
  </div>
</section>

<!-- PROGRAMS -->
<section class="programs" id="programs">
  <div class="programs-header">
    <div>
      <p class="section-kicker reveal">What We Offer</p>
      <h2 class="section-title reveal">TRAINING<br>PROGRAMS</h2>
    </div>
    <a href="#" class="btn-secondary reveal" style="margin-bottom:8px">All Programs</a>
  </div>
  <div class="programs-grid">
    <div class="program-card reveal">
      <img class="program-img" src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=600&q=80" alt="Strength">
      <div class="program-overlay">
        <p class="program-tag">Foundational</p>
        <h3 class="program-name">STRENGTH & POWER</h3>
        <p class="program-desc">Progressive overload methodology to build raw strength and explosive power.</p>
        <a href="#" class="program-link">Learn More</a>
      </div>
    </div>
    <div class="program-card reveal">
      <img class="program-img" src="https://images.unsplash.com/photo-1549576490-b0b4831ef60a?w=600&q=80" alt="HIIT">
      <div class="program-overlay">
        <p class="program-tag">Cardio</p>
        <h3 class="program-name">HIIT & BURN</h3>
        <p class="program-desc">High-intensity intervals designed to torch fat and build cardiovascular endurance.</p>
        <a href="#" class="program-link">Learn More</a>
      </div>
    </div>
    <div class="program-card reveal">
      <img class="program-img" src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=600&q=80" alt="Yoga">
      <div class="program-overlay">
        <p class="program-tag">Recovery</p>
        <h3 class="program-name">MOBILITY & FLOW</h3>
        <p class="program-desc">Active recovery and flexibility training to keep your body performing at peak.</p>
        <a href="#" class="program-link">Learn More</a>
      </div>
    </div>
  </div>
</section>

<!-- TRAINERS -->
<section class="trainers" id="trainers">
  <p class="section-kicker reveal">The Team</p>
  <h2 class="section-title reveal">ELITE<br>COACHES</h2>
  <div class="trainers-grid">
    <div class="trainer-card reveal">
      <div class="trainer-bar"></div>
      <img class="trainer-img" src="https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?w=400&q=80" alt="Trainer">
      <div class="trainer-info">
        <div class="trainer-name">MARCUS COLE</div>
        <div class="trainer-role">Strength & Conditioning</div>
      </div>
    </div>
    <div class="trainer-card reveal">
      <div class="trainer-bar"></div>
      <img class="trainer-img" src="https://images.unsplash.com/photo-1567013127542-490d757e51fc?w=400&q=80" alt="Trainer">
      <div class="trainer-info">
        <div class="trainer-name">SARA VEGA</div>
        <div class="trainer-role">HIIT & Nutrition</div>
      </div>
    </div>
    <div class="trainer-card reveal">
      <div class="trainer-bar"></div>
